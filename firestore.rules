rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(hid) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }
    function owner(hid) {
      return signedIn() && get(/databases/$(database)/documents/households/$(hid)).data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && uid == request.auth.uid;
      allow update: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.householdId == resource.data.householdId;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.householdId is string
        && owner(request.resource.data.householdId);
      allow update, delete: if signedIn()
        && owner(resource.data.householdId);
    }

    match /households/{hid} {
      // New households may be Free, or Plus while awaiting payment.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.plan in ['free','plus']
        && request.resource.data.subscriptionStatus == (request.resource.data.plan == 'free' ? 'active' : 'pending_payment');

      // Members may read metadata. Only the owner may change non-billing settings.
      allow read: if member(hid);
      allow update: if owner(hid)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','inviteCode','plusGoal','plusTheme','brandingTagline','updatedAt'
        ]);
      allow delete: if owner(hid);

      match /members/{uid} {
        allow read: if member(hid);
        allow create: if signedIn() && (
          (uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.inviteCode is string
            && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.inviteCode)).data.householdId == hid)
          || owner(hid)
        );
        allow update: if signedIn() && (
          (uid == request.auth.uid && member(hid) && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatar','colour','ageGroup','updatedAt']))
          || owner(hid)
        );
        allow delete: if signedIn() && (uid == request.auth.uid || owner(hid));
      }

      match /chores/{id} {
        allow read: if member(hid);
        allow create: if member(hid)
          && request.resource.data.points is int
          && request.resource.data.points >= 1
          && request.resource.data.points <= 1000
          && request.resource.data.name is string
          && request.resource.data.dueDate is string;
        allow update: if member(hid)
          && request.resource.data.points is int
          && request.resource.data.points >= 1
          && request.resource.data.points <= 1000
          && (request.resource.data.points == resource.data.points || owner(hid));
        allow delete: if owner(hid) || (member(hid) && resource.data.createdBy == request.auth.uid);
      }

      match /completions/{id} {
        allow read: if member(hid);
        allow create: if member(hid)
          && request.resource.data.personUid == request.auth.uid
          && request.resource.data.points is int
          && request.resource.data.points >= 1
          && request.resource.data.points == get(/databases/$(database)/documents/households/$(hid)/chores/$(request.resource.data.choreId)).data.points;
        allow update, delete: if false;
      }

      match /rewards/{id} {
        allow read: if member(hid);
        allow create: if member(hid)
          && request.resource.data.cost is int
          && request.resource.data.cost >= 1
          && request.resource.data.cost <= 100000;
        allow update: if owner(hid) || (member(hid) && resource.data.createdBy == request.auth.uid);
        allow delete: if owner(hid) || (member(hid) && resource.data.createdBy == request.auth.uid);
      }

      match /redemptions/{id} {
        allow read: if member(hid);
        allow create: if member(hid)
          && request.resource.data.personUid == request.auth.uid
          && request.resource.data.cost is int
          && request.resource.data.cost == get(/databases/$(database)/documents/households/$(hid)/rewards/$(request.resource.data.rewardId)).data.cost;
        allow update, delete: if false;
      }
    }
  }
}
